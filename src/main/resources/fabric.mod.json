{
	"schemaVersion": 1,
	"id": "no-block-delay",
	"version": "${version}",
	"name": "no-block-delay",
	"description": "A minimal mod that removes the 4 tick delay when placing blocks.",
	"authors": [
		"Shikaru0"
	],
	"contact": {
		"homepage": "https://github.com/Shikaru0",
		"sources": "https://github.com/Shikaru0/no-block-delay"
	},
	"license": "MIT",
	"icon": "assets/no-block-delay/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.NoBlockDelay"
		],
		"client": [
			"name.modid.client.NoBlockDelayClient"
		]
	},
	"mixins": [
		"no-block-delay.mixins.json",
		{
			"config": "no-block-delay.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}